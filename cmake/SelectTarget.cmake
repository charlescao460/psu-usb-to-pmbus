set(CUSB2PMBUS_MCU "RP2040" CACHE STRING "MCU implementation")
set_property(CACHE CUSB2PMBUS_MCU PROPERTY STRINGS RP2040)

set(CUSB2PMBUS_PSU "CORSAIR_AX1600I" CACHE STRING "PSU implementation")
set_property(CACHE CUSB2PMBUS_PSU PROPERTY STRINGS CORSAIR_AX1600I)

set(CUSB2PMBUS_BOARD "ADAFRUIT_FEATHER_RP2040_USB_HOST" CACHE STRING "Board implementation")
set_property(CACHE CUSB2PMBUS_BOARD PROPERTY STRINGS ADAFRUIT_FEATHER_RP2040_USB_HOST)

set(CUSB2PMBUS_PMBUS_ADDRESS "0x58" CACHE STRING "PMBus 7-bit target address")
set(CUSB2PMBUS_LOG_LEVEL "2" CACHE STRING "Firmware log level (0-3)")
option(CUSB2PMBUS_AX1600I_REGISTER_SCAN "Scan AX1600i registers and log two-byte replies" OFF)

if(CUSB2PMBUS_BUILD_FIRMWARE)
  if(NOT CUSB2PMBUS_MCU STREQUAL "RP2040")
    message(FATAL_ERROR "Unsupported CUSB2PMBUS_MCU: ${CUSB2PMBUS_MCU}")
  endif()
  if(NOT CUSB2PMBUS_PSU STREQUAL "CORSAIR_AX1600I")
    message(FATAL_ERROR "Unsupported CUSB2PMBUS_PSU: ${CUSB2PMBUS_PSU}")
  endif()
  if(NOT CUSB2PMBUS_BOARD STREQUAL "ADAFRUIT_FEATHER_RP2040_USB_HOST")
    message(FATAL_ERROR "Unsupported CUSB2PMBUS_BOARD: ${CUSB2PMBUS_BOARD}")
  endif()
  set(PICO_BOARD adafruit_feather_rp2040_usb_host CACHE STRING "Pico SDK board" FORCE)
endif()
